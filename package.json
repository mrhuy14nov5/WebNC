{
  "name": "webnc",
  "version": "1.0.0",
  "private": true,
  "description": "WebNC Node and MySQL development project",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --env-file=.env --watch server.js",
    "client": "npm run dev",
    "build": "vite build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "axios": "^1.8.4",
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "mysql2": "^3.24.4",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "vite": "^7.1.3"
  }
}
