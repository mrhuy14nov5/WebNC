{
  "name": "webnc",
  "version": "1.0.0",
  "private": true,
  "description": "UniManage learning management app with Express, React, MySQL and SQLite support",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env server.js",
    "start:server": "node --env-file-if-exists=.env server.js",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env server.js",
    "client": "npm run dev",
    "build": "vite build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "axios": "^1.8.4",
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.24.4",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "vite": "^7.1.3"
  }
}
