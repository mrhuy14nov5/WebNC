{
  "name": "WebNC",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": {
      "label": "WebNC app",
      "onAutoForward": "openBrowser"
    },
    "5173": {
      "label": "React Vite frontend"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "remoteUser": "node"
}