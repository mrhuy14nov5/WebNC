PORT=3000
# Bỏ comment 5 biến DB_* dưới đây để dùng MySQL; mặc định ứng dụng dùng SQLite.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=unimanage
# DB_USER=unimanage_user
# DB_PASSWORD=replace-with-a-strong-password
# DB_SSL=false
# DB_SSL_CA=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-12-plus-character-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=/api
